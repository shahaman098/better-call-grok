# Supabase (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=          # sent by Telegram in X-Telegram-Bot-Api-Secret-Token

# Stripe — TEST MODE ONLY (bcg refuses sk_live_)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=            # optional

# xAI (image generation for designs)
XAI_API_KEY=
# Model id for P2 design generation. Leave unset until then.
# Current Imagine model ids are listed at https://docs.x.ai/docs/models
XAI_IMAGE_MODEL=

# Optional: WhatsApp via Twilio sandbox, Option B phone line
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_VOICE_NUMBER=

# Behaviour
BCG_CURRENCY=GBP
BCG_MAX_COUNTERS=3
BCG_SUPPLIER_TIMEOUT_SEC=300
